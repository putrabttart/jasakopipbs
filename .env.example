# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the secret/service_role key, never the publishable/anon key.
# This value is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Admin password (sederhana, hanya untuk satu admin)
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Cron secret untuk endpoint /api/cron/auto-cancel
# Vercel Cron tidak butuh ini (di-set otomatis lewat header x-vercel-cron),
# tapi kalau pakai external cron seperti cron-job.org, set value random panjang.
CRON_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET

# Private API Kopi Kenangan. Obtain current, authorized values from the API
# owner/mobile integration. These values can expire and must stay server-only.
KK_API_BASE_URL=https://apps.kopikenangan.com/kk-api-kopikenangan/api
KK_AUTHORIZATION=YOUR_CURRENT_KK_AUTHORIZATION_TOKEN
KK_WTOKEN=YOUR_CURRENT_KK_WTOKEN
KK_DEVICE_ID=YOUR_CURRENT_KK_DEVICE_ID
KK_APPSFLYER_ID=YOUR_CURRENT_KK_APPSFLYER_ID
KK_APP_VERSION=YOUR_CURRENT_KK_APP_VERSION
KK_APP_VERSION_CODE=YOUR_CURRENT_KK_APP_VERSION_CODE
KK_SIGNATURE_STORES=YOUR_CURRENT_STORES_SIGNATURE
KK_SIGNATURE_MENU=YOUR_CURRENT_MENU_SIGNATURE
KK_SIGNATURE_OPTIONS=YOUR_CURRENT_OPTIONS_SIGNATURE
